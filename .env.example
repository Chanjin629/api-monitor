# 필요한 환경 변수 목록. 실제 값은 이 파일이 아니라 .env나 시스템 환경 변수에 넣는다.
# 개발 환경은 DB 값이 없어도 기본값으로 실행된다.

# MariaDB
DB_PORT=3307
DB_NAME=api_monitor
DB_USERNAME=api_monitor
DB_PASSWORD=

# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Access Token 서명 키. Base64로 인코딩한 32바이트 이상의 무작위 값. 운영에서는 반드시 지정한다.
JWT_SECRET=

# 요청 헤더 값 암호화 키. Base64로 인코딩한 정확히 32바이트의 무작위 값. 운영에서는 반드시 지정한다.
CRYPTO_SECRET=

# 개발용 Grafana 관리자 비밀번호. 지정하지 않으면 개발용 기본값을 쓴다. (보기는 로그인 없이 가능)
GRAFANA_ADMIN_PASSWORD=
