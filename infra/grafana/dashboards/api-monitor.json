{
  "uid": "api-monitor-server",
  "title": "API Monitor 서버",
  "description": "우리 서버 자체의 상태. 고객 API 검사 이력은 서비스 화면에서 본다.",
  "tags": ["api-monitor"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "API",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "API 요청 수 (초당, 상태 코드별)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{application=\"api-monitor\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API 응답 시간 p95 (목표 300ms, N-P4)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.3 }] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{application=\"api-monitor\", uri!~\"/actuator.*\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "row",
      "title": "검사",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "검사 수 (초당, 결과별, 목표 약 17건/초, N-P1)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "stacking": { "mode": "normal" }, "fillOpacity": 30 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(apimonitor_check_executions_total{application=\"api-monitor\"}[1m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "디스패치 지연 p95 (목표 5초, N-P3)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 10 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 5 }] },
          "custom": { "thresholdsStyle": { "mode": "line" } }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(apimonitor_check_dispatch_delay_seconds_bucket{application=\"api-monitor\"}[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "실행 중인 검사 (한도 200, N-P2)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 10 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "apimonitor_check_in_flight{application=\"api-monitor\"}",
          "legendFormat": "실행 중"
        }
      ]
    },
    {
      "type": "row",
      "title": "알림과 주기 작업",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "알림 발송 결과 (5분 동안)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (increase(apimonitor_notification_deliveries_total{application=\"api-monitor\"}[5m]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "실패한 작업 (1시간 동안)",
      "description": "0이 아니면 서버 로그를 확인한다. 검사 결과 저장 실패는 DB 장애를 뜻한다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task) (increase(apimonitor_scheduled_job_failures_total{application=\"api-monitor\"}[1h]))",
          "legendFormat": "{{task}}"
        },
        {
          "refId": "B",
          "expr": "increase(apimonitor_check_result_save_failures_total{application=\"api-monitor\"}[1h])",
          "legendFormat": "검사 결과 저장 실패"
        }
      ]
    },
    {
      "type": "row",
      "title": "JVM과 DB",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "JVM 힙 메모리",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(jvm_memory_used_bytes{application=\"api-monitor\", area=\"heap\"})",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "sum(jvm_memory_max_bytes{application=\"api-monitor\", area=\"heap\"})",
          "legendFormat": "최대"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "DB 연결 (HikariCP)",
      "description": "pending이 계속 0보다 크면 연결 풀이 모자란다.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hikaricp_connections_active{application=\"api-monitor\"})",
          "legendFormat": "사용 중"
        },
        {
          "refId": "B",
          "expr": "sum(hikaricp_connections_idle{application=\"api-monitor\"})",
          "legendFormat": "대기"
        },
        {
          "refId": "C",
          "expr": "sum(hikaricp_connections_pending{application=\"api-monitor\"})",
          "legendFormat": "연결을 기다리는 요청"
        }
      ]
    }
  ]
}
